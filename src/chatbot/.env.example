# CORS
ALLOW_ORIGINS='["*"]'
ALLOW_CREDENTIALS=False
ALLOW_HEADERS='["*"]'
ALLOW_METHODS='["*"]'

# OpenAI
OPENAI_API_KEY="add your key here"
OPENAI_MODEL="gpt-3.5-turbo"

# Redis is used for tokens, rate limiting, and optional chat history.
REDIS_HOST="redis"
REDIS_PORT=6379

# Authentication and rate limiting
USER_RATE_LIMIT_MAX_REQUESTS=10
USER_RATE_LIMIT_WINDOW_SECONDS=60
TOKEN_TTL=3600

# Conversation history
CHAT_HISTORY_MAX_MESSAGES=20
CHAT_HISTORY_TTL=3600
KEEP_HISTORY=true

# Retrieval-augmented generation
CONTEXT_FILE_PATH="/app/data/resume-data.txt"
RAG_EMBEDDING_MODEL="text-embedding-3-large"
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3
RAG_MIN_SIMILARITY=-0.5

# Cloudflare Turnstile (leave blank to disable verification locally)
TURNSTILE_SECRET_KEY=""

# Logging
LOG_LEVEL="INFO"
LOG_FOLDER="/var/log/nova-prime"
APP_NAME="chatbot"
